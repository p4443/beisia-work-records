{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "beisia-work-records.vercel.app"
        }
      ],
      "destination": "https://jizai-kado-kirokubo.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "beisia-work-records.vercel.app"
        }
      ],
      "destination": "https://jizai-kado-kirokubo.vercel.app/:path*",
      "permanent": true
    }
  ]
}
